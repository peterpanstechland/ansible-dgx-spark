---
# 敏感信息配置模板
# 复制此文件为 secrets.yml 并使用 ansible-vault 加密
#
#   cp group_vars/secrets.yml.example group_vars/secrets.yml
#   ansible-vault encrypt group_vars/secrets.yml
#
# 运行 playbook 时解密:
#   ansible-playbook ... --ask-vault-pass

# NVIDIA API Key (从 https://build.nvidia.com 获取)
nvidia_api_key: "nvapi-your-api-key-here"

# WireGuard 私钥（在 DGX 上 `wg genkey` 生成）
wg_dgx_private_key: "your-wireguard-private-key"

# 高德地图 API Key（Travel App 需要，从 https://lbs.amap.com 获取）
amap_api_key: "your-amap-api-key"

# 飞书集成（可选）
feishu_app_id: "cli_your_app_id"
feishu_app_secret: "your-feishu-app-secret"
